# ──────────────────────────────────────────────────────────
# NovaMart Ghana — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!
# ──────────────────────────────────────────────────────────

# ── AI ──────────────────────────────────────────────────────
# Required for Gemini AI API calls (Nova AI Copilot)
GEMINI_API_KEY="your_gemini_api_key_here"

# ── App URL ─────────────────────────────────────────────────
# The public URL where this app is hosted
# Used in email links (order tracking, password reset, etc.)
APP_URL="https://novamart.com.gh"

# ── Email / SMTP ─────────────────────────────────────────────
# Configure any SMTP provider below.
# 
# OPTION A: Gmail (easiest to set up)
#   1. Enable 2-Factor Auth on your Google account
#   2. Go to: myaccount.google.com/apppasswords
#   3. Generate an App Password for "Mail"
#   4. Use that 16-digit password as EMAIL_PASS
#
# OPTION B: SendGrid SMTP
#   EMAIL_HOST=smtp.sendgrid.net
#   EMAIL_PORT=587
#   EMAIL_SECURE=false
#   EMAIL_USER=apikey
#   EMAIL_PASS=your_sendgrid_api_key
#
# OPTION C: Brevo (Sendinblue) — Free tier: 300 emails/day
#   EMAIL_HOST=smtp-relay.brevo.com
#   EMAIL_PORT=587
#   EMAIL_SECURE=false
#   EMAIL_USER=your_brevo_login_email
#   EMAIL_PASS=your_brevo_smtp_key

EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="465"
EMAIL_SECURE="true"
EMAIL_USER="your_email@gmail.com"
EMAIL_PASS="your_gmail_app_password_here"
EMAIL_FROM_NAME="NovaMart Ghana"

# ── Paystack ─────────────────────────────────────────────────
# Add these once your Paystack account is approved
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public_key"
